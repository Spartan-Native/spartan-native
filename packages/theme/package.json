{
  "name": "@spartan-native/theme",
  "version": "0.2.0",
  "description": "Token contract, accent-to-palette derivation, NativeHost interface and provideSpartanNative(). Plain CSS + TS; the only required layer.",
  "license": "MIT",
  "author": "Roland Molnár",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spartan-Native/spartan-native.git",
    "directory": "packages/theme"
  },
  "homepage": "https://github.com/Spartan-Native/spartan-native/tree/main/packages/theme#readme",
  "bugs": {
    "url": "https://github.com/Spartan-Native/spartan-native/issues"
  },
  "keywords": [
    "angular",
    "spartan-ng",
    "native",
    "desktop",
    "theme"
  ],
  "peerDependencies": {
    "@angular/common": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@spartan-ng/brain": "^1.9.0",
    "@storybook/angular": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6"
  },
  "dependencies": {
    "tslib": "^2.3.0"
  },
  "sideEffects": [
    "*.scss"
  ],
  "exports": {
    "./styles/*": {
      "sass": "./styles/*.scss",
      "default": "./styles/*"
    },
    "./storybook/manager": {
      "default": "./storybook/manager.mjs"
    }
  },
  "peerDependenciesMeta": {
    "@storybook/angular": {
      "optional": true
    },
    "@storybook/addon-themes": {
      "optional": true
    }
  },
  "devDependencies": {
    "@ng-icons/core": "^33.4.0",
    "@ng-icons/lucide": "^33.4.0",
    "@spartan-ng/cli": "^1.9.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "storybook": "^10.6.6",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
