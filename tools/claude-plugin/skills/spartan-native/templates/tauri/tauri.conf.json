{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "My App",
  "version": "0.1.0",
  "identifier": "com.example.myapp",
  "build": {
    "beforeDevCommand": "npx ng serve",
    "devUrl": "http://localhost:4200",
    "beforeBuildCommand": "npx ng build",
    "frontendDist": "../dist/my-app/browser"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "My App",
        "width": 1120,
        "height": 740,
        "minWidth": 800,
        "minHeight": 520,
        "decorations": false
      }
    ]
  }
}
