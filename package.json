{
  "name": "spartan-native",
  "version": "0.2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve playground",
    "build": "npm run build:libs && ng build playground",
    "build:site": "node scripts/build-site.mjs",
    "build:libs": "ng build theme && node packages/theme/scripts/build-storybook-manager.mjs && ng build helm && ng build desktop-ui && ng build host-web && ng build host-electron && ng build host-conformance",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "storybook:theme": "ng run theme:storybook",
    "build-storybook:theme": "ng run theme:build-storybook",
    "storybook:helm": "ng run helm:storybook",
    "build-storybook:helm": "ng run helm:build-storybook",
    "storybook:desktop-ui": "ng run desktop-ui:storybook",
    "build-storybook:desktop-ui": "ng run desktop-ui:build-storybook",
    "theme:palette": "node packages/theme/scripts/generate-palette-defaults.mjs",
    "test:visual": "ng run theme:build-storybook && ng run desktop-ui:build-storybook && playwright test",
    "test:report": "npx playwright show-report dist/playwright-report",
    "pack:libs": "node scripts/pack-libs.mjs",
    "check:packages": "node scripts/check-packages.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint ."
  },
  "private": true,
  "packageManager": "npm@11.20.0",
  "dependencies": {
    "@angular/cdk": "^22.2.0",
    "@angular/common": "^22.2.0",
    "@angular/compiler": "^22.2.0",
    "@angular/core": "^22.2.0",
    "@angular/forms": "^22.2.0",
    "@angular/platform-browser": "^22.2.0",
    "@angular/router": "^22.2.0",
    "@ng-icons/core": "^33.4.0",
    "@ng-icons/lucide": "^33.4.0",
    "@spartan-ng/brain": "^1.9.0",
    "@tanstack/angular-charts": "0.16.0",
    "@tanstack/charts": "0.16.0",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.1",
    "embla-carousel": ">=8.0.0 <9.0.0",
    "embla-carousel-angular": "^22.0.0",
    "luxon": "^3.7.2",
    "ngx-scrollbar": "^19.1.5",
    "rxjs": "~7.8.0",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "^4.3.5",
    "tslib": "^2.3.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.6",
    "@angular/build": "^22.2.6",
    "@angular/cli": "^22.2.6",
    "@angular/compiler-cli": "^22.2.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.65.0",
    "@spartan-ng/cli": "^1.9.0",
    "@storybook/addon-a11y": "^10.6.6",
    "@storybook/addon-docs": "^10.6.6",
    "@storybook/addon-themes": "^10.6.6",
    "@storybook/angular": "^10.6.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@types/luxon": "^3.7.1",
    "angular-eslint": "22.6.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "globals": "^17.14.0",
    "jsdom": "^30.0.0",
    "ng-packagr": "^22.2.6",
    "postcss": "^8.5.32",
    "prettier": "^3.8.1",
    "remark-gfm": "^4.0.1",
    "storybook": "^10.6.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.71.0",
    "vitest": "^5.0.0"
  },
  "description": "Spartan Native: a native-look theme for spartan/ui (Angular) on Windows, macOS, GNOME, KDE and ChromeOS.",
  "license": "MIT",
  "author": "Roland Molnár",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Spartan-Native/spartan-native.git"
  },
  "homepage": "https://github.com/Spartan-Native/spartan-native#readme",
  "bugs": {
    "url": "https://github.com/Spartan-Native/spartan-native/issues"
  },
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "npm": ">=11.0.0"
  },
  "workspaces": [
    "packages/*",
    "packages/hosts/*"
  ]
}
